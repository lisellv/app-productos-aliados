    "_postman_id": "b6f2a2f0-financiamiento-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "rolId", "value": "1" },
    { "key": "aliadoId", "value": "1" },
    { "key": "clienteId", "value": "1" },
    { "key": "categoriaId", "value": "1" },
    { "key": "productoId", "value": "1" },
    { "key": "tipoFinanciamientoId", "value": "1" },
    { "key": "productoFinanciamientoId", "value": "1" },
