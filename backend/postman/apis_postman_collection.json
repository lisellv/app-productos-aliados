  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin@financiamiento.pe\",\n  \"password\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "api", "auth", "login" ] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.unset('token');",
                  "if (pm.response.code !== 200) { throw new Error('Login falló: revisa las credenciales'); }",
                  "let token = pm.response.text().trim();",
                  "if (token.startsWith('\\\"') && token.endsWith('\\\"')) { token = JSON.parse(token).trim(); }",
                  "const segments = token.split('.');",
                  "if (segments.length !== 3 || segments.some(segment => !segment)) { throw new Error('La respuesta de login no contiene un JWT válido'); }",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        }
      ]
    },
