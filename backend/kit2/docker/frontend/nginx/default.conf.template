server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 10m;

    # API del backend: mismo origen para el navegador, sin CORS
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Contrato OpenAPI y Swagger UI (si el backend usa springdoc)
    location /v3/api-docs { proxy_pass ${BACKEND_URL}; }
    location /swagger-ui  { proxy_pass ${BACKEND_URL}; }

    # Archivos con hash generados por Vite: se pueden cachear
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta de React Router devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
