# Variante para backends con Maven · renombrar a Dockerfile
FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw && ./mvnw -q dependency:go-offline || true
COPY src src
RUN ./mvnw -q package -DskipTests \
 && find target -maxdepth 1 -name "*.jar" ! -name "*-plain.jar" ! -name "*.original" -exec cp {} /app/app.jar \;

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd -r -g 1001 spring && useradd -r -u 1001 -g spring spring
COPY --from=build --chown=1001:1001 /app/app.jar app.jar
USER 1001
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]
