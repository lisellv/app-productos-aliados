# Copia este archivo como .env (en esta misma carpeta) y cambia los valores.
#   cp .env.example .env
# Docker Compose lee .env automáticamente al ejecutar los comandos aquí.

# --- Imagen del backend en GitHub (opción 2 de cada archivo) -----------
# Todo en minúsculas: ghcr.io/TU_USUARIO/REPO_BACKEND:latest
BACKEND_IMAGE=ghcr.io/tu-usuario/tu-repo-backend:latest

# --- Carpeta del código del backend (opción 3, con backend-local.yml) --
# Ruta relativa a ESTA carpeta (kit2/bases-de-datos). Ejemplos:
#   ../../ServicesBackend      (kit2 está al lado de tu repositorio)
#   C:/Users/ana/proyectos/mi-backend
BACKEND_DIR=../../ServicesBackend

# --- Clave para firmar los tokens JWT de tu backend --------------------
# Mínimo 32 caracteres. Solo para practicar: no la uses en producción.
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres-xyz
