# Copia este archivo como .env y ajusta los valores.
# Todos tienen un valor por defecto, así que .env es opcional.

# --- Base de datos (PostgreSQL) ---
DB_NAME=servicetechdb
DB_USER=postgres
DB_PASSWORD=postgres
# Si ya tienes PostgreSQL instalado en tu equipo, cambia a 5433
DB_PORT=5432
ADMINER_PORT=8081

# --- Rutas a los repositorios (relativas a esta carpeta kit2) ---
BACKEND_DIR=../ServicesBackend
FRONTEND_DIR=../frontend

# --- Puertos expuestos en tu equipo ---
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Seguridad ---
# Mínimo 32 caracteres (256 bits) para HS256. No uses este valor fuera de clases.
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres-xyz
